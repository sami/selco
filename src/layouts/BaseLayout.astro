---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Materials estimating tools for trade sales assistants' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const getUrl = (route: string) => {
  const base = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;
  return `${base}${route}`;
};
---

<!DOCTYPE html>
<html lang="en-GB" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Trade Materials Calculator</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={getUrl('/favicon.svg')} />
    <link rel="stylesheet" href={getUrl('/vendor/fontawesome/css/all.min.css')} />
    <link rel="stylesheet" href={getUrl('/vendor/open-sans/open-sans.css')} />
    <slot name="head" />
  </head>
  <body class="flex flex-col min-h-screen">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-brand-navy text-white font-bold py-2 px-4 rounded-md z-50">
      Skip to content
    </a>

    <header class="tmc-header">
      <div class="tmc-header-inner">
        <a href={baseUrl} class="tmc-wordmark">Trade Materials Calculator</a>
        <a href={baseUrl} class="tmc-nav-link">All calculators</a>
      </div>
    </header>

    {Astro.slots.has('breadcrumb') && (
      <div class="breadcrumbs">
        <slot name="breadcrumb" />
      </div>
    )}

    <main id="main-content" class="flex-grow max-w-[1280px] mx-auto px-[15px] py-8 w-full">
      <slot />
    </main>

    <footer class="tmc-footer">
      <div class="tmc-footer-inner">
        <p><strong>Trade Materials Calculator</strong>: estimating tools for trade sales assistants.</p>
        <p>An independent project, not affiliated with or endorsed by any builders' merchant or manufacturer. Product names belong to their owners. Quantities are estimates, so check them before ordering.</p>
      </div>
    </footer>

    <style>
      /* Neutral site chrome. Keep in step with scripts/strip-site-chrome.mjs, which injects the same markup into the frozen pages. */
      .tmc-header {
        background: #fff;
        border-bottom: 1px solid #e2e8f0;
      }
      .tmc-header-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 14px 15px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }
      .tmc-wordmark {
        font-size: 1.05rem;
        font-weight: 800;
        color: #1f2937;
        text-decoration: none;
      }
      .tmc-nav-link {
        font-size: 0.875rem;
        font-weight: 600;
        color: #475569;
        text-decoration: none;
      }
      .tmc-wordmark:hover,
      .tmc-nav-link:hover { text-decoration: underline; }

      .tmc-footer {
        margin-top: auto;
        background: #fff;
        border-top: 1px solid #e2e8f0;
        color: #64748b;
        font-size: 0.8rem;
        line-height: 1.5;
      }
      .tmc-footer-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 24px 15px;
      }
      .tmc-footer-inner p { margin: 0 0 6px; }
      .tmc-footer-inner p:last-child { margin: 0; }
      .tmc-footer-inner strong { color: #1f2937; }

      .breadcrumbs {
        max-width: 1280px;
        margin: 0 auto;
        padding: 20px 15px 0;
        font-size: 0.8rem;
        color: #475569;
        font-weight: 600;
        width: 100%;
        box-sizing: border-box;
      }
      .breadcrumbs :global(a) { color: #475569; text-decoration: none; }
      .breadcrumbs :global(span) { color: #cbd5e1; margin: 0 5px; font-weight: 400; }
      .breadcrumbs :global(.current) { color: #94a3b8; }
    </style>
  </body>
</html>
