---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { projectRegistry } from '../../../projects/registry';
import { FlooringCalculator } from '../../../components/hard-flooring/FlooringCalculator';

const project = projectRegistry.find(p => p.id === 'hard-flooring');
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title={project?.title || "Hard Flooring"} description={project?.blurb}>
  <Fragment slot="breadcrumb">
    <a href={baseUrl}>Home</a><span>/</span><span class="current">{project?.title}</span>
  </Fragment>

  <div class="max-w-3xl">
    <h1 class="text-3xl md:text-4xl font-bold text-brand-navy mb-4">{project?.title}</h1>
    <p class="text-lg text-text-muted mb-8">{project?.blurb}</p>

    <FlooringCalculator client:load />

    <p class="text-sm text-text-muted mt-8">
      Pack sizes vary from range to range, so flooring is quoted as the area to buy
      with 8% cutting waste. Always confirm quantities with a trade professional.
    </p>
  </div>
</BaseLayout>
